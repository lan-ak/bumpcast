// Copy to Secrets.xcconfig. xcconfig treats "//" as a comment, hence $(SLASH).
SLASH = /
SUPABASE_URL = https:$(SLASH)$(SLASH)your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key
SUPERWALL_API_KEY = pk_your-superwall-public-key
